{
  "manifest_version": 3,
  "name": "WyerpTaskboard Chat Wake",
  "version": "0.6.37",
  "description": "Role-isolated ChatGPT wake bridge for WyerpTaskboard.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:47831/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
